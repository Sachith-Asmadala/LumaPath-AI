{
  "name": "lumapath",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:imports": "node scripts/check-local-imports.mjs",
    "verify": "npm run check:imports && npm run check:i18n && npm run check:pseudo && npm run lint && npm run typecheck && npm test && npm run build",
    "verify:full": "npm run verify && npm run test:e2e",
    "dev:api": "python -m uvicorn apps.api.app.main:app --reload --port 8000",
    "test:api": "python -m pytest apps/api/tests",
    "verify:api": "python -m pytest apps/api/tests -q",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:pseudo": "node scripts/check-pseudo-localization.mjs"
  },
  "dependencies": {
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource-variable/red-hat-display": "^5.3.0",
    "@fullcalendar/core": "6.1.21",
    "@fullcalendar/daygrid": "6.1.21",
    "@fullcalendar/interaction": "6.1.21",
    "@fullcalendar/react": "6.1.21",
    "@fullcalendar/timegrid": "6.1.21",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^0.577.0",
    "motion": "^13.4.4",
    "next": "15.5.26",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.8.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.26",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.23"
    }
  }
}
