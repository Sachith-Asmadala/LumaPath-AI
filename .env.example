# Competition MVP v1.0 — local development values only. Never commit a private .env.
# FastAPI URL used by the Next.js server-side API proxies (server-only; not NEXT_PUBLIC).
LUMAPATH_API_URL=http://127.0.0.1:8000

# Study Assistant operational controls.
ASSISTANT_PROMPT_RETENTION_HOURS=0
ASSISTANT_SESSION_RETENTION_HOURS=72
ASSISTANT_RATE_LIMIT_PER_MINUTE=15
LUMAPATH_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:3001,http://localhost:3001

# Durable service/repository database. Back up this file and private uploads together.
LUMAPATH_DATABASE_PATH=./apps/api/data/lumapath.db

# DOC-F09 private document processing. Files are private by default and expire by policy.
DOCUMENT_STORAGE_PATH=./apps/api/data/private-documents
DOCUMENT_MAX_UPLOAD_BYTES=15728640
DOCUMENT_RETENTION_DAYS=30
DOCUMENT_REQUIRE_MALWARE_SCAN=false
DOCUMENT_WORKER_THREADS=2
DOCUMENT_MAX_PROCESSING_ATTEMPTS=3
DOCUMENT_UPLOADS_PER_MINUTE=8


# DOC-F18 private student analytics aggregation. Student-level endpoints remain private;
# DOC-F25 uses a separate privacy-preserving aggregate module for authorised cohorts.
ANALYTICS_WORKER_THREADS=1
ANALYTICS_MIN_COHORT_SIZE=10

# DOC-F14 portfolio analysis. No source-control connection is created by this story.
PORTFOLIO_ANALYSES_PER_MINUTE=10
# Disabled by default. Set only for a future trusted server-to-server source-control connector.
PORTFOLIO_INTEGRATION_INGEST_KEY=

# DOC-F15 CV Intelligence
CV_STORAGE_PATH=./apps/api/data/private-cv
CV_MAX_UPLOAD_BYTES=8388608
CV_REQUIRE_MALWARE_SCAN=false
CV_ANALYSES_PER_MINUTE=8

# DOC-F20 notification policy/delivery retries.
# Push/email providers are intentionally not configured in this prototype.
NOTIFICATION_DELIVERY_MAX_ATTEMPTS=3
NOTIFICATION_WORKER_INTERVAL_SECONDS=60

# DOC-F23 Calendar Integration
# Manual iCalendar/CSV import requires no provider credential.
CALENDAR_MAX_UPLOAD_BYTES=2097152
# Required only by a future explicitly-authorized university/LMS provider connector.
# Generate a Fernet key outside source control, for example with Python cryptography.
CALENDAR_CREDENTIAL_KEY=

# DOC-F28 opportunity catalogue
OPPORTUNITY_SOURCE_FRESHNESS_DAYS=30

# DOC-F25 institutional aggregate analytics.
# Minimum cohort size is shared with DOC-F18's reserved cohort-privacy setting above.
INSTITUTIONAL_ANALYTICS_RETENTION_DAYS=365
INSTITUTIONAL_ANALYTICS_FRESHNESS_HOURS=24
# REQUIRED in production: long random server-only secret used to HMAC-pseudonymise cohort membership.
INSTITUTIONAL_ANALYTICS_SUBJECT_KEY_SECRET=change-me-in-production
INSTITUTIONAL_ANALYTICS_PURPOSE=student_support_programme_improvement
# Development-only claims used by the Next.js proxy when no real admin auth session exists.
# Production must supply verified administrator claims instead of these demo defaults.
LUMAPATH_DEMO_ADMIN_ID=programme-admin-demo
LUMAPATH_DEMO_ADMIN_ROLE=programme_admin
LUMAPATH_DEMO_INSTITUTION_ID=luma-demo-university

# DOC-F30 daily intelligence ranking diversity/frequency controls.
CONTENT_FEED_DAILY_LIMIT=8
CONTENT_FEED_PER_SOURCE_LIMIT=2
CONTENT_FEED_PER_CATEGORY_LIMIT=3

# Competition monetisation MVP: development/demo/test permit demo plan switching.
# Set production explicitly for deployed APIs; the Next production build also blocks switching.
# REQUIRED for production: LUMAPATH_ENV=production. Development identity headers are then
# rejected until verified authentication is integrated. Do not expose a development API publicly.
LUMAPATH_ENV=development

# OPTIONAL synthetic staff defaults for development only; not production credentials.
LUMAPATH_DEMO_CURATOR_ID=taxonomy-reviewer-demo
LUMAPATH_DEMO_CURATOR_ROLE=taxonomy_reviewer
LUMAPATH_DEMO_REGION_SCOPE=international,lk
